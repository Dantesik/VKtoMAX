# ==========================================
# VK to MAX Reposter - Environment Configuration
# ==========================================
# Copy this file to .env and fill in your real values:
#
#   cp .env.example .env
#
# NEVER commit the .env file to git!
# ==========================================

# ------------------------------------------
# VK API credentials
# Get from: https://dev.vk.com/apps
# ------------------------------------------

# VK Service Token (long hex string, ~85 chars)
VK_SERVICE_TOKEN=a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6ab

# ID of the VK group to repost from
# ⚠️ Must include the leading minus sign!
VK_GROUP_ID=-200000001

# ------------------------------------------
# MAX Messenger credentials
# ------------------------------------------

# Bot token (get from @MasterBot via /newbot command)
# Format: random string with letters, digits and symbols, ~90 chars
MAX_BOT_TOKEN=AbCdEfGhIjKlMnOpQrStUvWxYz0123456789AbCdEfGhIjKlMnOpQrStUvWxYz0123456789AbCdEfGhIjKlMn

# Target channel ID in MAX
# ⚠️ Must include the leading minus sign!
MAX_CHAT_ID=-88888888888888

# Your numeric user ID in MAX (for admin-only commands)
# How to find: run the bot, send it any message, then check console for:
#   "[DEBUG] message from user_id=XXXXXXXX"
ADMIN_ID=99999999

# ------------------------------------------
# Platform settings (optional)
# ------------------------------------------

# MAX platform API endpoint
# Most installations use platform-api2.max.ru
API_URL=https://platform-api2.max.ru